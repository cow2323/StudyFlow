@model StudyFlow.Models.Booking

@{
    ViewData["Title"] = "Edit Booking";
}

<main class="container py-5">
    <section class="mx-auto" style="max-width: 650px;">

        <header class="mb-4">
            <h1 class="h2">Edit booking</h1>
            <p class="text-muted">
                Update the room or change the booking time below.
            </p>
        </header>

        <form asp-action="Edit" method="post" class="card shadow-sm p-4">

            <input type="hidden" asp-for="Id" />

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"
                 role="alert">
            </div>

            <fieldset>
                <legend class="h5 mb-3">Booking details</legend>

                <div class="mb-3">
                    <label asp-for="RoomId" class="form-label">
                        Room
                    </label>

                    <input asp-for="RoomId"
                           class="form-control"
                           aria-describedby="roomHelp" />

                    <div id="roomHelp" class="form-text">
                        Enter the room you want to book.
                    </div>

                    <span asp-validation-for="RoomId"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="StartTime" class="form-label">
                        Start time
                    </label>

                    <input asp-for="StartTime"
                           type="datetime-local"
                           class="form-control" />

                    <span asp-validation-for="StartTime"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-4">
                    <label asp-for="EndTime" class="form-label">
                        End time
                    </label>

                    <input asp-for="EndTime"
                           type="datetime-local"
                           class="form-control" />

                    <span asp-validation-for="EndTime"
                          class="text-danger">
                    </span>
                </div>
            </fieldset>

            <footer class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    Save changes
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Cancel
                </a>
            </footer>

        </form>

    </section>
</main>