@model IEnumerable<StudyFlow.Models.Booking>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "My Bookings";

    var now = DateTime.Now;
    var showPast = Context.Request.Query["tab"].ToString() == "past";

    var bookings = Model
        .Where(b => showPast
            ? b.EndTime <= now
            : b.EndTime > now)
        .OrderBy(b => b.StartTime)
        .ToList();
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="fw-bold">My Bookings</h1>
            <p class="text-muted">
                View and manage your room bookings.
            </p>
        </div>

       
       
        <a asp-controller="Room" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-plus-lg me-2"></i>
            New Booking
        </a>


    </div>

    <!-- Upcoming and Past -->
    <ul class="nav nav-underline mb-4">

        <li class="nav-item">
            <a asp-controller="Booking" asp-action="Index" asp-route-tab="upcoming"
               class="nav-link @(!showPast ? "active" : "")">
                Upcoming
            </a>
        </li>

        <li class="nav-item">
            <a asp-controller="Booking" asp-action="Index" asp-route-tab="past"
               class="nav-link @(showPast ? "active" : "")">
                Past
            </a>
        </li>

    </ul>

    @if (!bookings.Any())
    {
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body text-center py-5">

                <i class="bi bi-calendar-x fs-1 text-secondary"></i>

                <h4 class="mt-3">No bookings found</h4>

                <p class="text-muted">
                    You have no bookings in this category.
                </p>

                <a asp-controller="Room" asp-action="Index" class="btn btn-primary">
                    Find Rooms
                </a>

            </div>
        </div>
    }
    else
    {
        @foreach (var booking in bookings)
        {
            <div class="card border-0 shadow-sm rounded-3 mb-3">

                <div class="card-body p-3">

                    <div class="row align-items-center g-3">

                        <!-- Temporary room thumbnail -->
                        <div class="col-auto">
                            <div class="bg-light rounded-3 p-4">
                                <i class="bi bi-door-open fs-2 text-primary"></i>
                            </div>
                        </div>

                        <!-- Room information -->
                        <div class="col-12 col-md">

                            <h5 class="fw-bold mb-2">
                                Room @booking.RoomId
                            </h5>

                            <p class="text-muted mb-1">
                                <i class="bi bi-calendar3 me-2"></i>
                                @booking.StartTime.ToString("dd.MM.yyyy")
                            </p>

                            <p class="text-muted mb-0">
                                <i class="bi bi-clock me-2"></i>
                                @booking.StartTime.ToString("HH:mm")
                                -
                                @booking.EndTime.ToString("HH:mm")
                            </p>

                        </div>

                        <!-- Actions -->
                        <div class="col-12 col-md-auto">

                            @if (!showPast)
                            {
                                <div class="d-flex gap-2">

                                    <a asp-controller="Booking" asp-action="Edit" asp-route-id="@booking.Id"
                                       class="btn btn-outline-primary">
                                        Edit
                                    </a>

                                    <form asp-controller="Booking" asp-action="Delete" asp-route-id="@booking.Id" method="post">

                                        <button type="submit" class="btn btn-outline-danger"
                                                onclick="return confirm('Cancel this booking?');">
                                            Cancel
                                        </button>
                                    </form>

                                </div>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">
                                    Completed
                                </span>
                            }

                        </div>

                    </div>

                </div>
            </div>
        }

  
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


