
@{
    ViewData["Title"] = "Home";
    Layout = "_DashboardLayout";
}

<div class="container py-5">

    <!-- Welcome Section -->
    <div class="p-4 mb-4 bg-white rounded-4 shadow-sm">

        <div class="row align-items-center g-4">

            <!-- Left: Text -->
            <div class="col-lg-6">

                <h1 class="fw-bold mb-3"
                    style="color: #172B4D;">
                    Your space to study together.
                </h1>

                <p class="fs-5 text-secondary mb-4">
                    Find study rooms, create bookings
                    and organize your study sessions
                    in one place.
                </p>

                <!-- Main action -->
                <a asp-controller="Room"
                   asp-action="Index"
                   class="btn btn-primary btn-lg">

                    <i class="bi bi-search me-2"></i>
                    Find Rooms

                </a>

            </div>

            <!-- Right: Image -->
            <div class="col-lg-6">

                <img src="~/images/Home_side.png"
                     alt="Modern study room"
                     class="img-fluid rounded-4 w-100 object-fit-cover"
                     style="height: 350px;" />

            </div>

        </div>
    </div>

</div>
