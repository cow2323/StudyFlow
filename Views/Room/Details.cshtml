
@model StudyFlow.Models.Room

@{
    ViewData["Title"] = "Room Details";
    Layout = "_DashboardLayout";

    var imagePath = Model.Id switch
    {
        1 => "~/images/Study rooms_side/study room1.jpg",
        2 => "~/images/Study rooms_side/study room2.jpg",
        3 => "~/images/Study rooms_side/study room3.jpg",
        _ => null
    };
}

<div class="container py-4">

    <!-- Back to rooms -->
    <a asp-controller="Room"
       asp-action="Index"
       class="text-decoration-none">
        <i class="bi bi-arrow-left me-2"></i>
        Back to rooms
    </a>

    <div class="card border-0 shadow-sm rounded-4 mt-4">
        <div class="card-body p-4">

            <!-- Room image and information -->
            <div class="row g-4 align-items-center">

                <!-- Image -->
                <div class="col-md-5">

                    @if (imagePath != null)
                    {
                        <div class="ratio ratio-4x3">
                            <img src="@Url.Content(imagePath)"
                                 alt="@Model.Name"
                                 class="w-100 h-100 object-fit-cover rounded-3" />
                        </div>
                    }
                    else
                    {
                        <div class="bg-light rounded-3 p-5 text-center">
                            <i class="bi bi-door-open fs-1 text-primary"></i>
                            <p class="text-muted mt-2">
                                No room image available
                            </p>
                        </div>
                    }

                </div>

                <!-- Room Information -->
                <div class="col-md-7">

                    <h2 class="fw-bold mb-4">
                        @Model.Name
                    </h2>

                    <p>
                        <i class="bi bi-people me-2 text-primary"></i>
                        <strong>Capacity:</strong>
                        @Model.Capacity people
                    </p>

                    <p>
                        <i class="bi bi-geo-alt me-2 text-primary"></i>
                        <strong>Location:</strong>
                        @Model.Location
                    </p>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p>
                            <i class="bi bi-info-circle me-2 text-primary"></i>
                            @Model.Description
                        </p>
                    }

                </div>

            </div>

            <hr class="my-4" />

            <!-- Booking Section -->
            <h3 class="fw-bold mb-4">
                Book this room
            </h3>

            <form asp-controller="Booking"
                  asp-action="Create"
                  method="post"
                  id="bookingForm">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="RoomId"
                       value="@Model.Id" />

                <input type="hidden"
                       name="StartTime"
                       id="StartTime" />

                <input type="hidden"
                       name="EndTime"
                       id="EndTime" />

                <div class="row g-3 mb-4">

                    <!-- Date -->
                    <div class="col-md-4">

                        <label for="bookingDate" class="form-label">
                            <i class="bi bi-calendar3 me-2"></i>
                            Date
                        </label>

                        <input type="date"
                               id="bookingDate"
                               class="form-control"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")"
                               required />
                    </div>

                    <!-- Start Time -->
                    <div class="col-md-4">

                        <label for="startClock" class="form-label">
                            <i class="bi bi-clock me-2"></i>
                            Start Time
                        </label>

                        <input type="time"
                               id="startClock"
                               class="form-control"
                               value="10:00"
                               required />
                    </div>

                    <!-- End Time -->
                    <div class="col-md-4">

                        <label for="endClock" class="form-label">
                            <i class="bi bi-clock me-2"></i>
                            End Time
                        </label>

                        <input type="time"
                               id="endClock"
                               class="form-control"
                               value="12:00"
                               required />
                    </div>

                </div>

                <!-- Validation -->
                <div id="bookingError"
                     class="text-danger mb-3"
                     role="alert"
                     hidden></div>

                <!-- Submit -->
                <button type="submit"
                        class="btn btn-primary w-100 py-2">
                    <i class="bi bi-calendar-check me-2"></i>
                    Book Room
                </button>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("bookingForm")
            .addEventListener("submit", function (event) {

                const date = document.getElementById("bookingDate").value;
                const start = document.getElementById("startClock").value;
                const end = document.getElementById("endClock").value;

                const error = document.getElementById("bookingError");

                error.hidden = true;
                error.textContent = "";

                if (!date || !start || !end) {
                    event.preventDefault();
                    error.textContent = "Please select a date and time.";
                    error.hidden = false;
                    return;
                }

                const startValue = `${date}T${start}`;
                const endValue = `${date}T${end}`;

                if (end <= start) {
                    event.preventDefault();
                    error.textContent = "End time must be after start time.";
                    error.hidden = false;
                    return;
                }

                if (new Date(startValue) <= new Date()) {
                    event.preventDefault();
                    error.textContent = "You cannot book a room in the past.";
                    error.hidden = false;
                    return;
                }

                document.getElementById("StartTime").value = startValue;
                document.getElementById("EndTime").value = endValue;
            });
    </script>
}
