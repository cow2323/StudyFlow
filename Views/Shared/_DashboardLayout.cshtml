<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - StudyFlow</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>

<body>
    <div class="container-fluid">
        <div class="row min-vh-100">

            <!-- Sidebar -->
            <aside class="col-12 col-md-3 col-xl-2 text-white p-4" style="background-color: #172B4D;">

                <h3 class="fw-bold mb-5">
                    🎓 StudyFlow
                </h3>

                <nav class="nav flex-column gap-3">

                    <a class="nav-link text-white" asp-controller="Home" asp-action="Index">
                        Home
                    </a>
                    
                    <a class="nav-link text-white" asp-controller="User" asp-action="Login">
                        Login
                    </a>

                    <a class="nav-link text-white" asp-controller="Room" asp-action="Index">
                        Study Rooms
                    </a>

                    <a class="nav-link text-white" asp-controller="Booking" asp-action="Index">
                        Bookings
                    </a>

                    

                </nav>
            </aside>

            <!-- Main Content -->
            <main class="col-12 col-md-9 col-xl-10 p-4" style="background-color: #F8FAFC;">

                @RenderBody()

            </main>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>