@model StudyFlow.ViewModels.StudySessionViewModel

@{
    ViewData["Title"] = "Create Study Session";
    Layout = "_DashboardLayout";
}

<div class="container-fluid py-4">

    <h1 class="fw-bold">Create Study Session</h1>

    <p class="text-muted mb-4">
        Organize a study session and invite others to join.
    </p>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-4">

            <!-- Form fields will go here -->

            <form asp-action="Create" method="post">

            <!-- Room Selection -->
            <div class="mb-3">
                <label for="roomSelect" class="form-label fw-semibold">
                    Room
                </label>

                <select asp-for="RoomId" d="roomSelect" name="RoomId" class="form-select" required>
                    <option value="" selected disabled>Select a room</option>
                    <option value="1">Room 1</option>
                    <option value="2">Room 2</option>
                    <option value="3">Room 3</option>
                </select>
            </div>

            <!-- Date and Time -->
            <div class="row g-3 mb-3">

                

                <!-- Start Time -->
                <div class="col-md-4">
                    <label for="startTime" class="form-label fw-semibold">
                        Start Time
                    </label>
                    <input asp-for="StartTime" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" step="60" required />
                </div>

                <!-- End Time -->
                <div class="col-md-4">
                    <label for="endTime" class="form-label fw-semibold">
                        End Time
                    </label>
                    <input asp-for="EndTime" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" step="60" required />
                </div>


                <!-- Course and Topic -->
                <div class="row g-3 mb-3">

                    <!-- Course -->
                    <div class="col-md-6">
                        <label for="course" class="form-label fw-semibold">
                            Course
                        </label>

                        <input asp-for="Course" type="text" id="course" name="Course" class="form-control" placeholder="e.g. ITPE3200"
                               required />
                    </div>

                    <!-- Topic -->
                    <div class="col-md-6">
                        <label for="topic" class="form-label fw-semibold">
                            Topic
                        </label>

                        <input asp-for="Topic" type="text" id="topic" name="Topic" class="form-control" placeholder="e.g. React and MVC"
                               required />
                    </div>


                    <!-- Description -->
                    <div class="mb-3">
                        <label for="description" class="form-label fw-semibold">
                            Description (Optional)
                        </label>

                        <textarea asp-for="Description" id="description" name="Description" class="form-control" rows="3"
                                  placeholder="Write a short description of your study session..."></textarea>
                    </div>

                    <!-- Session Visibility -->
                    <div class="mb-4">
                        <label for="isPublic" class="form-label fw-semibold">
                            Session Visibility
                        </label>

                        <select asp-for="IsPublic" id="isPublic" name="IsPublic" class="form-select">
                            <option value="true">Public</option>
                            <option value="false">Private</option>
                        </select>

                        <div class="form-text">
                            Choose whether other students can discover this session.
                        </div>
                    </div>

                    <!-- Form Actions -->
                    <div class="d-flex justify-content-end gap-2 mt-4">

                        <a asp-controller="StudySession" asp-action="Index" class="btn btn-outline-secondary">
                            Cancel
                        </a>

                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-plus-circle me-2"></i>
                            Create Session
                        </button>

                    </div>


                </div>


            </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {

    <partial name= "_ValidationScriptsPartial"/>


}