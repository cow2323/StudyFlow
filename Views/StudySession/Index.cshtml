@model IEnumerable<StudyFlow.Models.StudySession>

@{
    ViewData["Title"] = "Study Sessions";
    Layout = "_DashboardLayout";

var now = DateTime.Now;
    var showPast = Context.Request.Query["tab"].ToString() == "past";

    var sessions = Model
        .Where(s => showPast
            ? s.EndTime <= now
            : s.EndTime > now)
        .OrderBy(s => s.StartTime)
        .ToList();


}

<div class="container-fluid py-4">

    <h1 class="fw-bold">Study Sessions</h1>

    <p class="text-muted">
        Find and join study sessions with other students.
    </p>
    <!-- Create Study Session Button -->
    <a asp-controller="StudySession" asp-action="Create" class="btn btn-primary mb-4">
        <i class="bi bi-plus-lg me-2"></i>
        Create Study Session
    </a>

    <!-- Study Session Tabs -->
   
    <ul class="nav nav-underline mb-4">
        <li class="nav-item">
            <button type="button" id="allSessionsTab" class="nav-link active">
                All Sessions
            </button>
        </li>

        <li class="nav-item">
            <button type="button" id="mySessionsTab" class="nav-link">
                My Sessions
            </button>
        </li>
    </ul>


   
    <!-- Search and Filter -->
    <div class="row g-3 mb-4">

        <!-- Search -->
        <div class="col-md-9">
            <label for="sessionSearch" class="form-label">
                Search sessions
            </label>

            <div class="input-group">
                <span class="input-group-text bg-white">
                    <i class="bi bi-search"></i>
                </span>

                <input type="search" id="sessionSearch" class="form-control"
                       placeholder="Search by course, topic or keyword..." />
            </div>
        </div>

        <!-- Filter -->
        <div class="col-md-3">
            <label for="sessionFilter" class="form-label">
                Filter
            </label>

            <select id="sessionFilter" class="form-select">
                <option value="upcoming">Upcoming</option>
                <option value="past">Past</option>
                <option value="all">All</option>
            </select>
        </div>

    </div>


    <!-- Study Session Cards -->




    @if (!sessions.Any())
    {
        
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body text-center py-5">

                <i class="bi bi-calendar-x fs-1 text-secondary"></i>

                <h4 class="mt-3">No Study Sessions found</h4>

                <p class="text-muted">
                    There are no study sessions at the moment. Feel free to make one! 📚
                </p>

            </div>
        </div>
    }

    else 
    {
        @foreach (var session in sessions){

 <div id="allSessionsContent" class="row g-4">
             <div class="col-12 col-md-6 col-xl-4">
            <div class="card border-0 shadow-sm rounded-3 h-100">
                <div class="card-body p-3 d-flex flex-column">

                    <h5 class="fw-bold">@session.Topic</h5>

                    <div class="mb-3">
                        <span class="badge bg-primary">@session.Course</span>
                        <span class="badge bg-light text-dark">
                            @session.Description 
                        </span>
                    </div>

                    <p class="mb-2">
                        <i class="bi bi-calendar3 me-2"></i>
                        @session.StartTime - @session.EndTime
                    </p>

                    <p class="mb-2">
                        <i class="bi bi-geo-alt me-2"></i>
                        @session.Room?.Name
                    </p>

                    <p class="mb-3">
                        <i class="bi bi-people me-2"></i>
                        @session.Participants.Count /@session.Room?.Capacity joined
                    </p>

                    <form asp-controller="StudySession" asp-action="AddUser" asp-route-id="@session.Id" method="Post">
                    <button class="btn btn-primary mt-auto" type="submit">
                        Join Session
                    </button>
                    </form>

                </div>
            </div>
        </div>

</div>
            


            



        }
    }

    


</div>
