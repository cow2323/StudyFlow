@model StudyFlow.ViewModels.AuthViewModel

<div class="row g-0 shadow-lg rounded-4 overflow-hidden my-5">

    <div class="col-lg-5 bg-primary bg-gradient text-white p-5
        d-flex flex-column justify-content-center">

        <h2 class="fw-bold">🎓 StudyFlow</h2>

        <p class="lead">
            Your space to study together.
        </p>

    </div>

    <div class="col-lg-7 bg-white p-5">

        <h2 class="fw-bold mb-4">Welcome back</h2>

        <!-- Tab Panes -->

        <ul class="nav nav-tabs" id="loginTabs" role=tablist>

            <li class=nav-item role=presentation>
                <button class="nav-link active" id="loginTab" data-bs-toggle="tab" data-bs-target="#collapseLogin"
                        type="button" aria-expanded="true" aria-controls="collapseLogin" aria-selected="true">Login</button>
            </li>

            <li class=nav-item role=presentation>
                <button class="nav-link" id="createUserTab" data-bs-toggle="tab" data-bs-target="#collapseCreateUser"
                        type="button" role="tab" aria-controls="collapseCreateUser" aria-selected="false">
                    Register
                </button>
            </li>
        </ul>


        <div class="tab-content" id="loginTabContent">
            <div class="tab-pane fade show active" id="collapseLogin" role="tabpanel" aria-labelledby="loginTab">

                <!-- Form for login -->
                <partial name="_Login"  model= "Model.Login"/>
            </div>


            <div class="tab-pane fade" id="collapseCreateUser" role="tabpanel" aria-labelledby="createUserTab">
                <!--Form For Registration--->
                
                <partial name="_Register"  model="Model.Registration"/>

            </div>
                
        </div>

    </div>
</div>